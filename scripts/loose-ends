#!/usr/bin/env python3
"""loose-ends: pick up unfinished work. List it, show one item, resolve it, or draft the resume prompt.

Sources (existing feeds; this script makes no model calls):
  $MISSION_CONTROL_HOME/data/chats.json      data.loose_ends (kept kinds: todo_open register_open
                                             closeout_handoff repo_dirty nightly_finding)
  $MISSION_CONTROL_HOME/data/attention.json  data.board
  <repo>/todo.md                             '## Active Next Steps' bullets only, never the whole file
  scan-unfinished-work --json --repo <repo>  dirty / unpushed / behind

Usage:
  loose-ends [--repo PATH] [--limit N] [--json] [--all-kinds]   ranked list; saves last.json for index lookups
  loose-ends show <id|index>
  loose-ends resolve <id|index>                                 runs the item's own resolve command; never edits human docs
  loose-ends [--repo PATH] prompt <id|index> [--out FILE]       writes a Goal-format resume skeleton under prompts/
  loose-ends --self-test
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path(os.environ.get("MISSION_CONTROL_HOME") or Path.home() / ".mission-control")
SCRIPT_DIR = Path(__file__).resolve().parent
# ponytail: 16,064 of 16,504 ledger rows were these two kinds on 2026-09-01; --all-kinds brings them back
NOISE = {"register_unverified", "chat_open_end"}
SEVERITY = {"red": 3, "amber": 2, "grey": 1, "green": 0}
# ponytail: todo.md sections carry instruction bullets next to work bullets; these openers are instructions
RULE_BULLET = re.compile(r"^- (Keep|When|Put|If|Capture|Do not|Never|Use)\b")


def load_json(path):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def repo_name(repo):
    return Path(repo).name if repo else ""


def item(**kw):
    base = dict(id="", kind="", source="", repo="", title="", text="", severity=1, age_days=0,
                resolve_cmd="", hint="", source_node="", resume_cmd="", view_cmd="", chat_title="")
    base.update(kw)
    return base


def from_ledger(all_kinds):
    data = load_json(HOME / "data" / "chats.json").get("data", {})
    nodes = {n.get("id"): n for n in data.get("nodes") or [] if isinstance(n, dict)}
    out = []
    for e in data.get("loose_ends") or []:
        if not all_kinds and e.get("kind") in NOISE:
            continue
        node = nodes.get((e.get("source_node") or "").split(":", 1)[-1], {})
        sev = e.get("severity")
        out.append(item(id=e.get("id", ""), kind=e.get("kind", ""), source="ledger",
                        repo=e.get("repo") or node.get("repo") or "", title=e.get("title") or "",
                        text=e.get("text") or "", severity=SEVERITY.get(sev, sev if isinstance(sev, int) else 1),
                        age_days=int(e.get("age_days") or 0), resolve_cmd=e.get("resolve_cmd") or "",
                        hint=e.get("action_hint") or "", source_node=e.get("source_node") or "",
                        resume_cmd=node.get("resume_cmd") or "", view_cmd=node.get("view_cmd") or "",
                        chat_title=node.get("title") or ""))
    return out


def from_attention():
    data = load_json(HOME / "data" / "attention.json").get("data", {})
    now = time.time()
    out = []
    for b in data.get("board") or []:
        created = b.get("created_at") or now
        out.append(item(id=str(b.get("id")), kind=b.get("kind") or "attention", source="attention",
                        title=b.get("title") or "", text=b.get("why") or b.get("text") or "",
                        severity=int(b.get("severity") or 1), age_days=int((now - created) / 86400),
                        resolve_cmd=f"dashboard attention resolve {b.get('id')}",
                        hint="decide, then resolve", source_node=b.get("source") or ""))
    return out


def from_todo(repo):
    path = Path(repo) / "todo.md"
    if not path.is_file():
        return []
    out, inside = [], False
    for n, line in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        if line.startswith("## "):
            inside = line.strip() == "## Active Next Steps"
            continue
        if inside and line.startswith("- ") and not line.startswith("- [x]") and not RULE_BULLET.match(line):
            out.append(item(id=f"todo:{repo_name(repo)}:{n}", kind="todo_open", source="todo.md",
                            repo=repo_name(repo), title=line[2:].strip()[:90], text=line[2:].strip(), severity=2,
                            resolve_cmd=f"# move todo.md line {n} under '## Completed' with date and evidence",
                            hint="close it or write the prompt", source_node=f"repo:{repo_name(repo)}",
                            view_cmd=f"sed -n '{n}p' '{path}'"))
    return out


def from_scan(repo):
    scanner = SCRIPT_DIR / "scan-unfinished-work"
    if not scanner.exists():
        return []
    try:
        run = subprocess.run([str(scanner), "--json", "--repo", repo], capture_output=True, text=True,
                             timeout=90, env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
        data = json.loads(run.stdout or "{}")
    except (subprocess.SubprocessError, ValueError):
        return []
    out = []
    for rep in data.get("repos") or []:
        name, path = rep.get("repo") or repo_name(repo), rep.get("path") or repo
        checks = (("dirty", rep.get("dirty_files") or 0, "uncommitted files", f"git -C '{path}' status --short", 2),
                  ("unpushed", rep.get("ahead") or 0, "commits ahead of upstream", f"git -C '{path}' log --oneline @{{u}}..HEAD", 2),
                  ("behind", rep.get("behind") or 0, "commits behind upstream", f"git -C '{path}' log --oneline HEAD..@{{u}}", 1))
        for key, count, what, cmd, sev in checks:
            if count:
                out.append(item(id=f"scan:{name}:{key}", kind=f"repo_{key}", source="scan-unfinished-work", repo=name,
                                title=f"{name}: {count} {what} on {rep.get('branch')}", text=f"{count} {what}",
                                severity=sev, resolve_cmd="# " + cmd, hint="commit, push, merge, or ignore",
                                source_node=f"repo:{name}", view_cmd=cmd))
    return out


def collect(repo, all_kinds):
    items = from_ledger(all_kinds) + from_attention()
    if repo:
        items += from_todo(repo) + from_scan(repo)
        want = repo_name(repo)
        items = [i for i in items if not i["repo"] or i["repo"] == want]  # ponytail: repo match by basename
    want = repo_name(repo)
    items.sort(key=lambda i: (-i["severity"], 0 if want and i["repo"] == want else 1, -i["age_days"], i["id"]))
    seen, out = set(), []
    for i in items:
        if i["id"] not in seen:
            seen.add(i["id"])
            out.append(i)
    return out


def save_last(items):
    (HOME / "loose-ends").mkdir(parents=True, exist_ok=True, mode=0o700)
    (HOME / "loose-ends" / "last.json").write_text(json.dumps(items), encoding="utf-8")


def find(ref):
    items = load_json(HOME / "loose-ends" / "last.json") or []
    if ref.isdigit() and 1 <= int(ref) <= len(items):
        return items[int(ref) - 1]
    for i in items:
        if i["id"] == ref:
            return i
    sys.exit(f"loose-ends: no item {ref!r} in the last listing; run `loose-ends` first")


def bin_path(name):
    for candidate in (SCRIPT_DIR / name, HOME / "bin" / name):
        if candidate.exists():
            return str(candidate)
    return name


def cmd_list(a):
    items = collect(a.repo, a.all_kinds)
    save_last(items)
    shown = items[: a.limit]
    if a.json:
        print(json.dumps(shown, indent=1))
        return
    if not items:
        print("No loose ends found.")
        return
    scope = f" for {repo_name(a.repo)}" if a.repo else ""
    print(f"{len(items)} loose ends{scope}, top {len(shown)} (severity, kind, repo, age, title):")
    for n, i in enumerate(shown, 1):
        print(f"{n:>3}. [{i['severity']}] {i['kind']:<17} {(i['repo'] or '-'):<24} {i['age_days']:>3}d  {i['title'][:72]}")
    if len(items) > len(shown):
        print(f"... {len(items) - len(shown)} more; raise --limit")
    print("next: loose-ends show <n> | resolve <n> | prompt <n>")


def cmd_show(a):
    i = find(a.ref)
    for key in ("id", "kind", "source", "repo", "severity", "age_days", "title", "text", "hint",
                "source_node", "chat_title", "resume_cmd", "view_cmd", "resolve_cmd"):
        if i.get(key) not in ("", None, 0):
            print(f"{key}: {i[key]}")


def cmd_resolve(a):
    i = find(a.ref)
    cmd = i["resolve_cmd"]
    if not cmd or cmd.startswith("#"):
        print("closed by hand:", cmd.lstrip("# ") or "no resolve command recorded")
        return
    parts = cmd.split()
    parts[0] = bin_path(parts[0])
    print("+", " ".join(parts))
    sys.exit(subprocess.call(parts))


def cmd_prompt(a):
    i = find(a.ref)
    slug = re.sub(r"[^a-z0-9]+", "-", i["title"].lower())[:40].strip("-") or "item"
    out = Path(a.out) if a.out else HOME / "prompts" / f"{time.strftime('%Y-%m-%d')}-{slug}.md"
    out.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    source = i["source_node"] + (f" ({i['chat_title']})" if i.get("chat_title") else "")
    body = f"""Goal: <one sentence: the outcome that closes this loose end>
Runner: <Claude Code | Codex | Cursor | Hermes>
Model: claude-opus-5
Effort: high
Repo: {a.repo or '<absolute path>'}
Branch: <branch to work on>
Context:
- Loose end: {i['id']} ({i['kind']}, severity {i['severity']}, {i['age_days']} days old)
- Title: {i['title']}
- Text: {i['text']}
- Source: {source}
- Reopen: {i.get('resume_cmd') or 'n/a'}
- Read: {i.get('view_cmd') or 'n/a'}
- Resolve when done: {i['resolve_cmd'] or 'n/a'}
- Facts gathered this session: <files read, commands run, what is already true>
Acceptance:
- <observable condition>
Verify: <exact commands and expected output>
Stop: <the boundary that ends the work or forces a question>
Record: <todo.md line, record file, or register row to update>, then run the resolve command above
Prompt file: `{out}`
"""
    out.write_text(body, encoding="utf-8")
    os.chmod(out, 0o600)
    print(out)


def self_test():
    global HOME
    tmp = Path(tempfile.mkdtemp(prefix="loose-ends-test."))
    HOME = tmp
    (tmp / "data").mkdir()
    (tmp / "repo").mkdir()
    (tmp / "data" / "chats.json").write_text(json.dumps({"data": {
        "nodes": [{"id": "n1", "repo": "repo", "title": "chat one", "resume_cmd": "claude --resume n1"}],
        "loose_ends": [
            {"id": "n1:a", "kind": "closeout_handoff", "severity": "amber", "age_days": 9, "title": "finish handoff",
             "text": "t", "resolve_cmd": "chat-graph resolve n1 a", "source_node": "claude:n1", "repo": "repo"},
            {"id": "n1:b", "kind": "register_unverified", "severity": "amber", "age_days": 50, "title": "noise",
             "text": "t", "resolve_cmd": "chat-graph resolve n1 b", "source_node": "claude:n1", "repo": "repo"},
            {"id": "r:c", "kind": "nightly_finding", "severity": "red", "age_days": 1, "title": "red elsewhere",
             "text": "t", "resolve_cmd": "chat-graph resolve r c", "source_node": "repo:other", "repo": "other"}]}}))
    (tmp / "data" / "attention.json").write_text(json.dumps({"data": {"board": [
        {"id": "att:1", "kind": "manual", "severity": 3, "title": "decide x", "why": "w",
         "created_at": time.time() - 3 * 86400, "source": "audit"}]}}))
    (tmp / "repo" / "todo.md").write_text(
        "# TODO\n\n## Active Next Steps\n- Keep this section short.\n- ship the thing | owner: T\n\n## Completed\n- [x] done\n")
    items = collect(str(tmp / "repo"), False)
    ids = [i["id"] for i in items]
    assert "n1:b" not in ids, "noise kind must be filtered"
    assert "r:c" not in ids, "another repo's item must be filtered under --repo"
    assert ids[0] == "att:1", f"highest severity first, got {ids}"
    assert "n1:a" in ids and items[[i["id"] for i in items].index("n1:a")]["resume_cmd"] == "claude --resume n1"
    assert any(i["id"].startswith("todo:") and i["title"].startswith("ship the thing") for i in items), ids
    assert not any("Keep this section" in i["title"] for i in items), "instruction bullets are not work"
    assert "n1:b" in [i["id"] for i in collect("", True)], "--all-kinds restores noise"
    save_last(items)
    assert find("1")["id"] == "att:1"

    class Args:
        ref, out, repo = "2", str(tmp / "p.md"), str(tmp / "repo")
    cmd_prompt(Args)
    text = (tmp / "p.md").read_text()
    assert text.startswith("Goal:") and "Model: claude-opus-5" in text and f"Prompt file: `{tmp / 'p.md'}`" in text
    shutil.rmtree(tmp)
    print("loose-ends self-test: ok")


def main(argv=None):
    p = argparse.ArgumentParser(prog="loose-ends", description=__doc__.split("\n\n")[0])
    p.add_argument("--repo", default=os.environ.get("LOOSE_ENDS_REPO", ""))
    p.add_argument("--limit", type=int, default=15)
    p.add_argument("--json", action="store_true")
    p.add_argument("--all-kinds", action="store_true")
    p.add_argument("--self-test", action="store_true")
    sub = p.add_subparsers(dest="cmd")
    for name in ("show", "resolve", "prompt"):
        s = sub.add_parser(name)
        s.add_argument("ref")
        if name == "prompt":
            s.add_argument("--out")
    a = p.parse_args(argv)
    if a.self_test:
        return self_test()
    if a.repo:
        a.repo = str(Path(a.repo).expanduser().resolve())
    return {None: cmd_list, "show": cmd_show, "resolve": cmd_resolve, "prompt": cmd_prompt}[a.cmd](a)


if __name__ == "__main__":
    main()
