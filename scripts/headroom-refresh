#!/usr/bin/env python3
"""headroom-refresh - force a fresh usage poll, on demand and debounced.

The collector runs on its own 60s LaunchAgent and self-gates per provider
(60s while a provider is in use, 300s idle). That is the right cadence for a
background job, but it means the number on screen can be minutes old at the
moment you actually look at it.

This closes that gap from the other end: the panel calls this when it opens, so
what you are looking at was fetched seconds ago. Polling costs an API call, so
it only happens when someone is actually looking, and a debounce stops repeated
opens from hammering the providers.

The collector's path is READ FROM ITS LaunchAgent, never hardcoded. The runtime
is a hash-pinned copy under gi-runtime/usage-routing/<rev>/ that moves on every
re-pin; hardcoding it would silently refresh a stale binary, or nothing at all.
"""

import fcntl
import json
import os
import plistlib
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
PLIST = os.path.join(HOME, "Library", "LaunchAgents", "com.gillettes.ai-headroom.plist")
STATE_DIR = os.path.join(HOME, ".mission-control", "self-repair")
STAMP = os.path.join(STATE_DIR, "headroom-refresh.stamp")
LOCK = os.path.join(STATE_DIR, "headroom-refresh.lock")
# Two opens in quick succession must not mean two polls.
MIN_INTERVAL_S = 20
# A failed collector must not suppress retry forever, but also must not be
# retried in a tight loop by every panel open: bounded failure backoff.
FAILURE_BACKOFF_S = 120
TIMEOUT_S = 25


def collector_argv(plist_path=PLIST):
    """Program arguments for the installed collector, or None."""
    try:
        with open(plist_path, "rb") as handle:
            plist = plistlib.load(handle)
    except (OSError, ValueError):
        return None
    argv = plist.get("ProgramArguments")
    if not isinstance(argv, list) or not argv:
        return None
    if not all(isinstance(a, str) and a for a in argv):
        return None
    if not os.path.exists(argv[-1]):
        return None
    return argv


def _read_state(stamp_path):
    try:
        with open(stamp_path, "r") as handle:
            state = json.load(handle)
        return state if isinstance(state, dict) else {}
    except (OSError, ValueError):
        return {}


def due(now, stamp_path=STAMP, min_interval_s=MIN_INTERVAL_S,
        failure_backoff_s=FAILURE_BACKOFF_S):
    """True when a refresh may run.

    Only a provably fresh SUCCESS stamp debounces. A malformed, non-finite, or
    future stamp fails OPEN (refresh proceeds). A recent FAILURE allows retry
    after the short backoff instead of waiting the full success interval.
    """
    state = _read_state(stamp_path)
    if not state:
        return True
    last = state.get("last_epoch")
    if isinstance(last, bool) or not isinstance(last, (int, float)):
        return True
    if last != last or last in (float("inf"), float("-inf")):
        return True  # NaN / infinity: fail open.
    if last > now:
        return True  # Clock-skewed future stamp: never trust it to debounce.
    age = now - last
    if state.get("outcome") == "success":
        return age >= min_interval_s
    # Failure (or unknown outcome from an old runtime): bounded backoff.
    return age >= failure_backoff_s


def stamp(now, stamp_path=STAMP, outcome="success"):
    os.makedirs(os.path.dirname(stamp_path), mode=0o700, exist_ok=True)
    tmp = stamp_path + ".tmp.%d" % os.getpid()
    with open(tmp, "w") as handle:
        json.dump({"last_epoch": int(now), "outcome": outcome}, handle)
    os.replace(tmp, stamp_path)


def refresh(now=None, force=False):
    now = time.time() if now is None else now
    os.makedirs(os.path.dirname(LOCK), mode=0o700, exist_ok=True)
    lock_fd = os.open(LOCK, os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            # Another refresh owns the read-check-run window. Treat it as the
            # debounce it exists to provide.
            return "in-flight elsewhere", 0
        if not force and not due(now):
            return "debounced", 0
        argv = collector_argv()
        if argv is None:
            return "collector not installed", 0
        # --no-notify: the notification sender is a separate job with its own health.
        # A refresh must never be able to fail because of it.
        try:
            done = subprocess.run(argv + ["--force", "--no-notify"],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                                  timeout=TIMEOUT_S, check=False)
        except (OSError, subprocess.SubprocessError) as exc:
            stamp(now, outcome="failed")
            return "failed: %s" % str(exc)[:120], 1
        if done.returncode != 0:
            # A failed poll is NOT a refreshed screen: stamp the failure so the
            # next open retries after the backoff instead of being suppressed.
            stamp(now, outcome="failed")
            return "collector exit %d" % done.returncode, done.returncode
        stamp(now, outcome="success")
        return "refreshed", 0
    finally:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
        finally:
            os.close(lock_fd)


def self_test():
    import tempfile
    failures = []

    def check(name, cond):
        print(("PASS " if cond else "FAIL ") + name)
        if not cond:
            failures.append(name)

    with tempfile.TemporaryDirectory() as tmp:
        s = os.path.join(tmp, "stamp.json")
        now = 1_000_000.0
        check("first call is due", due(now, s))
        stamp(now, s)
        check("an immediate second call is debounced", not due(now + 1, s))
        check("a call past the window is due again", due(now + MIN_INTERVAL_S, s))

        bad = os.path.join(tmp, "corrupt.json")
        open(bad, "w").write("{not json")
        check("a corrupt stamp fails open, not closed", due(now, bad))

        # Hostile / drifted stamp values must never suppress refresh.
        for name, value in (("nan", float("nan")), ("inf", float("inf"))):
            path = os.path.join(tmp, "stamp-%s.json" % name)
            with open(path, "w") as handle:
                json.dump({"last_epoch": value, "outcome": "success"}, handle)
            check("a %s stamp fails open" % name, due(now, path))
        future = os.path.join(tmp, "stamp-future.json")
        with open(future, "w") as handle:
            json.dump({"last_epoch": now + 10_000, "outcome": "success"}, handle)
        check("a future stamp fails open", due(now, future))

        failed_recent = os.path.join(tmp, "stamp-failed.json")
        with open(failed_recent, "w") as handle:
            json.dump({"last_epoch": now - 30, "outcome": "failed"}, handle)
        check("a recent failure retries after backoff, not the full window",
              due(now + FAILURE_BACKOFF_S, failed_recent)
              and not due(now + 5, failed_recent))

        legacy = os.path.join(tmp, "stamp-legacy.json")
        with open(legacy, "w") as handle:
            json.dump({"last_epoch": now - 5}, handle)
        check("an outcome-less legacy stamp uses failure semantics",
              due(now + FAILURE_BACKOFF_S, legacy)
              and not due(now + 5, legacy))

        success_old_shape = os.path.join(tmp, "stamp-success.json")
        stamp(now - 1, success_old_shape)
        check("a fresh success stamp debounces", not due(now, success_old_shape))

        # The collector path comes from the plist, never a constant.
        p = os.path.join(tmp, "a.plist")
        with open(p, "wb") as h:
            plistlib.dump({"ProgramArguments": ["/usr/bin/true", os.path.join(tmp, "gone")]}, h)
        check("a plist pointing at a missing binary is refused",
              collector_argv(p) is None)
        real = os.path.join(tmp, "real")
        open(real, "w").write("#!/bin/sh\n")
        with open(p, "wb") as h:
            plistlib.dump({"ProgramArguments": ["/usr/bin/env", "python3", real]}, h)
        check("a valid plist yields its argv", collector_argv(p) == ["/usr/bin/env", "python3", real])
        with open(p, "wb") as h:
            plistlib.dump({"ProgramArguments": []}, h)
        check("an empty argv is refused", collector_argv(p) is None)
        check("a missing plist is refused", collector_argv(os.path.join(tmp, "nope.plist")) is None)

    print("%d passed; %d failed" % (15 - len(failures), len(failures)))
    return 1 if failures else 0


if __name__ == "__main__":
    argv = sys.argv[1:]
    if "--self-test" in argv:
        sys.exit(self_test())
    message, code = refresh(force="--force" in argv)
    print("headroom-refresh: %s" % message)
    sys.exit(code)
