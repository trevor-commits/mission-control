#!/usr/bin/env python3
"""loose-tree: the live hierarchical loose-ends board.

One store (`<state>/loosetree/store.json`, dashboard-state adjacent) holding a
flat node array with parent links: project -> area -> task -> subtask. Parents
roll up (done only when every descendant is done/dropped). A parallel `Inbox`
subtree holds machine-captured items (from the chats/git feeds); `adopt`
promotes them into the real tree. Zero model calls; stdlib only.

Usage:
  loose-tree add   [--parent ID] [--kind K] --title T [--status S]
                   [--origin O] [--harness H] [--session ID] [--repo R]
                   [--commit C] [--note N] [--auto] [--auto-key K]
  loose-tree update ID [--status S] [--title T] [--commit C] [--note N]
                   [--decision D] [--parent P]
  loose-tree done ID | drop ID | adopt ID [--parent P]
  loose-tree board [--all] | show ID | json
  loose-tree manage ID --plan FILE | queue
  loose-tree dispatch ID --observation FILE
  loose-tree receipt ID --evidence FILE | verify ID --evidence FILE
  loose-tree supersede ID --evidence FILE
  loose-tree --self-test

Statuses: todo doing blocked needs-decision awaiting-trevor done dropped
"""
import argparse
import fcntl
from contextlib import contextmanager
import hashlib
import json
import os
import sys
import tempfile
import time
from datetime import datetime

KINDS = ("project", "area", "task", "subtask", "inbox")
STATUSES = ("todo", "doing", "blocked", "needs-decision", "awaiting-trevor",
            "done", "dropped")
LEAF_DONE = {"done", "dropped"}
ORDER = {"awaiting-trevor": 0, "needs-decision": 1, "blocked": 2, "doing": 3,
         "todo": 4, "done": 5, "dropped": 6}
CHIP = {"awaiting-trevor": "WAIT-YOU", "needs-decision": "DECIDE",
        "blocked": "BLOCKED", "doing": "DOING", "todo": "TODO",
        "done": "DONE", "dropped": "DROP"}


def default_store():
    """State path — deliberately NOT data/loosetree.json (that is the feed)."""
    mc_home = os.environ.get("MISSION_CONTROL_HOME") or os.path.expanduser(
        "~/.mission-control")
    return os.path.join(mc_home, "loosetree", "store.json")


def _store_path(args):
    return getattr(args, "store", None) or os.environ.get("LOOSE_TREE_STORE") \
        or default_store()


def _now():
    return int(time.time())


def _load(path):
    try:
        with open(path, encoding="utf-8") as f:
            d = json.load(f)
    except FileNotFoundError:
        return {"version": 1, "nodes": []}
    if not isinstance(d, dict) or d.get("version") != 1 or not isinstance(d.get("nodes"), list):
        raise ValueError("invalid loose-tree store; preserved without changes")
    ids = set()
    for n in d["nodes"]:
        if not isinstance(n, dict) or not n.get("id") or n["id"] in ids or n.get("status") not in STATUSES:
            raise ValueError("invalid or duplicate tree node; store preserved")
        ids.add(n["id"])
    return d


@contextmanager
def store_lock(path):
    """Serialize the entire read/modify/write transaction across processes."""
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path + ".lock", "a", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def _check_parent(data, nid, parent):
    visited = {nid}
    while parent:
        if parent in visited:
            raise ValueError("parent would create a cycle")
        visited.add(parent)
        node = _find(data, parent)
        if node is None:
            raise ValueError("no such parent " + parent)
        parent = node.get("parent")


def _check_close(data, nid):
    if any(n.get("parent") == nid and n["status"] not in LEAF_DONE for n in data["nodes"]):
        raise ValueError("item still has open children")


def _save(path, data):
    """Atomic write. LOOSE_TREE_FAULT=1 injects a post-buffer-flush failure so
    tests can prove the on-disk store survives a mid-write crash."""
    data["updated_at"] = _now()
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".loosetree-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=1, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
            if os.environ.get("LOOSE_TREE_FAULT") == "1":
                raise RuntimeError("injected fault (LOOSE_TREE_FAULT=1)")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _new_id():
    stamp = datetime.now().strftime("T-%Y%m%d-%H%M-")
    return stamp + hashlib.sha1(os.urandom(16)).hexdigest()[:16]


def _children_map(data):
    m = {}
    for n in data["nodes"]:
        m.setdefault(n.get("parent"), []).append(n)
    return m


def _recompute(data):
    """Roll up counts bottom-up; parents whose descendants are all done/dropped
    become done (their prior open status is parked in _pre_rollup_status and
    restored if a descendant reopens)."""
    by_id = {n["id"]: n for n in data["nodes"]}
    kids = _children_map(data)
    seen = set()

    def roll(nid, depth=0):
        if nid in seen or depth > 64:  # cycle guard for malformed stores
            return {"done": 0, "total": 0}
        seen.add(nid)
        n = by_id[nid]
        children = kids.get(nid, [])
        if not children:
            n["rollup"] = {"done": 1 if n["status"] in LEAF_DONE else 0,
                           "total": 1}
            return n["rollup"]
        agg = {"done": 0, "total": 0}
        for c in children:
            r = roll(c["id"], depth + 1)
            agg["done"] += r["done"]
            agg["total"] += r["total"]
        n["rollup"] = agg
        if n.get("workflow"):
            # Child completion is not the parent's acceptance evidence.
            if agg["done"] != agg["total"] and n["status"] == "done":
                n["status"] = "blocked"
                n["verification"] = {"result": "stale", "reason": "child outcome reopened"}
            return agg
        if agg["total"] > 0 and agg["done"] == agg["total"]:
            if n["status"] not in LEAF_DONE:
                n["_pre_rollup_status"] = n["status"]
                n["status"] = "done"
        elif n["status"] == "done" and "_pre_rollup_status" in n:
            n["status"] = n.pop("_pre_rollup_status")
        return agg

    for n in data["nodes"]:
        if not n.get("parent") or n.get("parent") not in by_id:
            roll(n["id"])
    return data


def _origin_t(origin):
    prefix = (origin or "").split(":", 1)[0]
    return prefix if prefix in ("chat", "profile", "repo", "cron", "system") \
        else "system"


def _find(data, nid):
    for n in data["nodes"]:
        if n.get("id") == nid:
            return n
    return None


def cmd_add(args):
    path = _store_path(args)
    data = _load(path)
    ids = {n["id"] for n in data["nodes"]}
    if args.parent and args.parent not in ids:
        print("loose-tree: no such parent %s" % args.parent, file=sys.stderr)
        return 1
    title = (args.title or "").strip()
    if not title:
        print("loose-tree: --title is required", file=sys.stderr)
        return 1
    if args.auto:
        status = "todo"
    elif args.status:
        status = args.status
    else:
        status = "todo"
    if status not in STATUSES:
        print("loose-tree: bad status %s" % status, file=sys.stderr)
        return 1
    n = {
        "id": _new_id(),
        "parent": args.parent,
        "kind": args.kind or ("inbox" if args.auto else "task"),
        "title": title[:120],
        "status": status,
        "origin": args.origin or "",
        "origin_t": _origin_t(args.origin or ""),
        "harness": args.harness or "",
        "session_id": args.session or "",
        "repo": args.repo or "",
        "commit": args.commit or "",
        "created_at": _now(),
        "updated_at": _now(),
        "auto": bool(args.auto),
        "auto_key": args.auto_key or "",
        "note": args.note or "",
        "decision": "",
    }
    data["nodes"].append(n)
    _recompute(data)
    _save(path, data)
    print(n["id"])
    return 0


def cmd_update(args):
    path = _store_path(args)
    data = _load(path)
    n = _find(data, args.id)
    if not n:
        print("loose-tree: no such item %s" % args.id, file=sys.stderr)
        return 1
    if args.status:
        if n.get("superseded_by"):
            raise ValueError("superseded work stays retired; record a new authorized outcome")
        if args.status not in STATUSES:
            print("loose-tree: bad status %s" % args.status, file=sys.stderr)
            return 1
        if args.status in LEAF_DONE:
            if n.get("workflow"):
                raise ValueError("managed work closes through verify or supersede")
            _check_close(data, args.id)
        if n.get("dispatch", {}).get("state") in ("prepared", "delivered", "unknown"):
            raise ValueError("reconcile the existing dispatch before changing status")
        n["status"] = args.status
    if args.title is not None:
        t = args.title.strip()
        if not t:
            print("loose-tree: --title cannot be empty", file=sys.stderr)
            return 1
        n["title"] = t[:120]
    if args.commit is not None:
        n["commit"] = args.commit.strip()
    if args.note is not None:
        n["note"] = args.note.strip()
    if args.decision is not None:
        # A recorded decision answers a needs-decision/awaiting-trevor item and
        # makes it actionable again; children carry the follow-through work.
        if not args.decision.strip():
            raise ValueError("an empty decision is not an answer")
        n["decision"] = args.decision.strip()
        if n["status"] in ("needs-decision", "awaiting-trevor"):
            n["status"] = "todo"
    if args.parent is not None:
        if args.parent == n["id"]:
            print("loose-tree: item cannot be its own parent", file=sys.stderr)
            return 1
        if args.parent not in {x["id"] for x in data["nodes"]}:
            print("loose-tree: no such parent %s" % args.parent,
                  file=sys.stderr)
            return 1
        _check_parent(data, n["id"], args.parent)
        n["parent"] = args.parent
    n["updated_at"] = _now()
    _recompute(data)
    _save(path, data)
    print(n["id"])
    return 0


def cmd_done(args):
    path = _store_path(args)
    data = _load(path)
    n = _find(data, args.id)
    if not n:
        print("loose-tree: no such item %s" % args.id, file=sys.stderr)
        return 1
    if n.get("workflow") or n.get("superseded_by"):
        raise ValueError("managed work requires independent artifact verification")
    open_kids = [c for c in data["nodes"]
                 if c.get("parent") == args.id and c["status"] not in LEAF_DONE]
    if open_kids:
        print("loose-tree: %s still has %d open child(ren): %s" % (
            args.id, len(open_kids),
            ", ".join(c["id"] + " " + c["title"][:30] for c in open_kids)),
            file=sys.stderr)
        return 1
    n["status"] = "done"
    n.pop("_pre_rollup_status", None)
    n["updated_at"] = _now()
    _recompute(data)
    _save(path, data)
    print(n["id"])
    return 0


def cmd_drop(args):
    path = _store_path(args)
    data = _load(path)
    n = _find(data, args.id)
    if not n:
        print("loose-tree: no such item %s" % args.id, file=sys.stderr)
        return 1
    if n.get("workflow"):
        raise ValueError("managed work retires through evidence-backed supersede")
    _check_close(data, args.id)
    n["status"] = "dropped"
    n["updated_at"] = _now()
    _recompute(data)
    _save(path, data)
    print(n["id"])
    return 0


def cmd_adopt(args):
    path = _store_path(args)
    data = _load(path)
    n = _find(data, args.id)
    if not n:
        print("loose-tree: no such item %s" % args.id, file=sys.stderr)
        return 1
    if args.parent:
        if args.parent not in {x["id"] for x in data["nodes"]}:
            print("loose-tree: no such parent %s" % args.parent, file=sys.stderr)
            return 1
        if args.parent == n["id"]:
            print("loose-tree: item cannot be its own parent", file=sys.stderr)
            return 1
    n["auto"] = False
    if args.parent:
        _check_parent(data, n["id"], args.parent)
        n["parent"] = args.parent
        n["kind"] = "task" if n["kind"] == "inbox" else n["kind"]
    n["updated_at"] = _now()
    _recompute(data)
    _save(path, data)
    print(n["id"])
    return 0


def _render(n, depth=0):
    chip = CHIP.get(n["status"], (n["status"] or "?").upper())
    line = "  " * depth + "[%s] %s" % (chip, n.get("title") or "(untitled)")
    extra = []
    r = n.get("rollup")
    if isinstance(r, dict) and r.get("total", 0) > 1:
        extra.append("%d/%d done" % (r.get("done", 0), r.get("total", 0)))
    if n.get("origin"):
        extra.append(n["origin"])
    if n.get("harness"):
        extra.append(n["harness"])
    if n.get("session_id"):
        extra.append("session " + n["session_id"])
    if n.get("repo"):
        extra.append("repo " + n["repo"])
    if n.get("commit"):
        extra.append(n["commit"])
    if extra:
        line += "  · " + " · ".join(extra)
    return line


def cmd_board(args):
    path = _store_path(args)
    data = _load(path)
    kids = _children_map(data)
    out = []
    show_inbox = bool(getattr(args, "inbox", False))

    def inbox_summary(n, depth):
        children = kids.get(n["id"], [])
        open_n = sum(1 for c in children if c["status"] not in LEAF_DONE)
        return ("  " * depth + "[INBOX] Inbox (auto-captured) — %d open item%s "
                "(loose-tree board --inbox to expand)" % (
                    open_n, "" if open_n == 1 else "s"))

    def walk(nid, depth):
        for c in sorted(kids.get(nid, []),
                        key=lambda n: (ORDER.get(n["status"], 9),
                                       -(n.get("updated_at") or 0))):
            if c["status"] in LEAF_DONE and not args.all:
                continue
            if c.get("kind") == "inbox" and not c.get("parent") and not show_inbox:
                out.append(inbox_summary(c, depth))
                continue
            out.append(_render(c, depth))
            walk(c["id"], depth + 1)

    roots = sorted((n for n in data["nodes"]
                    if not n.get("parent") or n.get("parent") not in
                    {x["id"] for x in data["nodes"]}),
                   key=lambda n: (ORDER.get(n["status"], 9),
                                  -(n.get("updated_at") or 0)))
    for r in roots:
        if r["status"] in LEAF_DONE and not args.all:
            continue
        if r.get("kind") == "inbox" and not show_inbox:
            out.append(inbox_summary(r, 0))
            continue
        out.append(_render(r))
        walk(r["id"], 1)
    print("\n".join(out) if out else "No loose ends. Nothing owed.")
    return 0


def cmd_show(args):
    path = _store_path(args)
    data = _load(path)
    n = _find(data, args.id)
    if not n:
        print("loose-tree: no such item %s" % args.id, file=sys.stderr)
        return 1
    print(_render(n))
    for c in data["nodes"]:
        if c.get("parent") == args.id:
            print("  " + _render(c))
    if n.get("note"):
        print("note: " + n["note"])
    if n.get("decision"):
        print("decision: " + n["decision"])
    prov = " ".join(x for x in (n.get("origin"), n.get("harness"),
                                n.get("session_id") and
                                ("session " + n["session_id"]), n.get("repo"),
                                n.get("commit")) if x)
    if prov:
        print("provenance: " + prov)
    return 0


def cmd_json(args):
    path = _store_path(args)
    data = _load(path)
    json.dump(data, sys.stdout, indent=1, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


def _json_evidence(path):
    if not os.path.isabs(path) or os.path.islink(path) or not os.path.isfile(path):
        raise ValueError("evidence must be an absolute regular-file path")
    with open(path, "rb") as f:
        raw = f.read(4 * 1024 * 1024 + 1)
    if len(raw) > 4 * 1024 * 1024:
        raise ValueError("evidence exceeds 4 MiB")
    value = json.loads(raw)
    if not isinstance(value, dict):
        raise ValueError("evidence must be an object")
    return value, {"path": path, "sha256": hashlib.sha256(raw).hexdigest()}


def _fresh(value, age=86400):
    return type(value) is int and 0 <= _now() - value <= age


def _text(value):
    return isinstance(value, str) and bool(value.strip())


def _task(args):
    path = _store_path(args)
    data = _load(path)
    n = _find(data, args.id)
    if n is None:
        raise ValueError("no such item " + args.id)
    return path, data, n


def _record(path, data, n, event, evidence):
    n.setdefault("workflow_history", []).append({"at": _now(), "event": event, **evidence})
    n["updated_at"] = _now()
    _recompute(data)
    _save(path, data)


def _pending(n):
    return n.get("dispatch", {}).get("state") in ("prepared", "delivered", "unknown")


def cmd_manage(args):
    path, data, n = _task(args)
    if _pending(n) or n["status"] in LEAF_DONE or n.get("superseded_by"):
        raise ValueError("existing dispatch or terminal outcome needs reconciliation first")
    plan, binding = _json_evidence(args.plan)
    for key in ("owner_session", "owner_harness", "authority", "next_action"):
        if not _text(plan.get(key)):
            raise ValueError("missing plan field: " + key)
    acceptance = plan.get("acceptance")
    dependencies = plan.get("dependencies", [])
    if not isinstance(acceptance, list) or not acceptance or not all(map(_text, acceptance)) or len(set(acceptance)) != len(acceptance):
        raise ValueError("acceptance must contain unique concrete checks")
    if not isinstance(dependencies, list) or any(not isinstance(d, str) or d == n['id'] or _find(data, d) is None for d in dependencies):
        raise ValueError("dependencies must name other existing tasks")
    priority = plan.get("priority", 2)
    if type(priority) is not int or priority not in range(4):
        raise ValueError("priority must be 0..3")
    if n.get("workflow"):
        n.setdefault("workflow_history", []).append(dict(at=_now(), event="plan-replaced",
            workflow=n["workflow"], dispatch=n.pop("dispatch", None), verification=n.pop("verification", None)))
    n["workflow"] = {k: plan[k].strip() for k in ("owner_session", "owner_harness", "authority", "next_action")}
    n["workflow"].update(acceptance=acceptance, dependencies=dependencies,
                         priority=priority, reviewed_at=_now(), binding=binding)
    # Planning is explicit source review. Questions/holds keep their status.
    n["auto"] = False
    _record(path, data, n, "managed", binding)
    print(n["id"])
    return 0


def work_queue(data):
    result = {key: [] for key in ("ready", "doing", "waiting", "verified_done")}
    result.update(candidate_count=0, legacy_closed_count=0, retired_count=0)
    parents = {n.get("parent") for n in data["nodes"]}
    for n in data["nodes"]:
        if n['id'] in parents and not n.get("workflow"):
            continue
        plan = n.get("workflow") or {}
        row = {k: n.get(k) for k in ("id", "title", "status", "repo")}
        row.update(owner=plan.get("owner_session"), owner_harness=plan.get("owner_harness"), next_action=plan.get("next_action"),
                   acceptance=plan.get("acceptance", []), priority=plan.get("priority", 2))
        if n["status"] == "dropped" or n.get("superseded_by"):
            result["retired_count"] += 1
        elif n["status"] == "done":
            if n.get("verification", {}).get("result") == "passed":
                result["verified_done"].append(row)
            else:
                result["legacy_closed_count"] += 1
        elif not plan or n.get("auto"):
            result["candidate_count"] += 1
        elif _pending(n):
            row["waiting_for"] = "existing dispatch: " + n["dispatch"]["state"]
            result["doing"].append(row)
        elif n["status"] == "doing":
            row["waiting_for"] = "owner already working; inspect before routing"
            result["doing"].append(row)
        elif n["status"] != "todo":
            row["waiting_for"] = n["status"]
            result["waiting"].append(row)
        elif not _fresh(plan.get("reviewed_at")):
            row["waiting_for"] = "source review older than 24 hours"
            result["waiting"].append(row)
        elif any(c.get("parent") == n['id'] and c['status'] not in LEAF_DONE for c in data['nodes']):
            row["waiting_for"] = "open child outcomes"
            result["waiting"].append(row)
        elif any((_find(data, d) or {}).get("verification", {}).get("result") != "passed"
                 or (_find(data, d) or {}).get("status") != "done" for d in plan.get("dependencies", [])):
            row["waiting_for"] = "dependency lacks verified completion"
            result["waiting"].append(row)
        else:
            result["ready"].append(row)
    for key in ("ready", "doing", "waiting", "verified_done"):
        result[key].sort(key=lambda n: (n["priority"], n["id"]))
    return result


def cmd_queue(args):
    print(json.dumps(work_queue(_load(_store_path(args))), indent=2))
    return 0


def cmd_dispatch(args):
    path, data, n = _task(args)
    if n["id"] not in {r["id"] for r in work_queue(data)["ready"]}:
        raise ValueError("task is not ready; inspect its source/dependencies/dispatch")
    plan = n["workflow"]
    obs, binding = _json_evidence(args.observation)
    if (obs.get("owner_session") != plan["owner_session"] or obs.get("state") != "idle"
            or not _fresh(obs.get("observed_at"), 300)
            or obs.get("latest_intent_checked") is not True or obs.get("no_active_writer") is not True
            or obs.get("authority") != plan["authority"] or not _text(obs.get("source"))):
        raise ValueError("fresh exact-owner idle state and current authority are required")
    if any(_pending(other) and other.get("workflow", {}).get("owner_session") == plan["owner_session"]
           for other in data["nodes"]):
        raise ValueError("owner already has an unresolved dispatch")
    attempt = _new_id()
    n["dispatch"] = dict(id=attempt, state="prepared", owner_session=plan["owner_session"],
                         prepared_at=_now(), observation=binding, plan=plan["binding"])
    n["status"] = "doing"
    _record(path, data, n, "dispatch-prepared", {"attempt": attempt, **binding})
    print(json.dumps(n["dispatch"]))
    return 0


def cmd_receipt(args):
    path, data, n = _task(args)
    receipt, binding = _json_evidence(args.evidence)
    dispatch = n.get("dispatch") or {}
    if (not _pending(n) or receipt.get("attempt") != dispatch.get("id")
            or receipt.get("owner_session") != dispatch.get("owner_session")
            or receipt.get("state") not in ("delivered", "unknown")
            or (receipt.get("state") == "delivered" and not _text(receipt.get("turn_id")))
            or not _text(receipt.get("source"))):
        raise ValueError("receipt must bind the existing attempt and owner")
    if dispatch.get("state") == "delivered":
        if receipt["state"] != "delivered" or receipt.get("turn_id") != dispatch.get("turn_id"):
            raise ValueError("confirmed delivery turn is immutable")
        print(n['id'])  # exact repeated receipt is an idempotent readback
        return 0
    dispatch.update(state=receipt["state"], receipt=binding,
                    turn_id=receipt.get("turn_id") if receipt["state"] == "delivered" else None)
    _record(path, data, n, "dispatch-" + receipt["state"], binding)
    print(n['id'])
    return 0


def _checked_artifacts(proof, criteria):
    checks = proof.get("checks")
    if not isinstance(checks, list) or not checks or {c.get("criterion") for c in checks if isinstance(c, dict)} != set(criteria):
        raise ValueError("proof must cover every acceptance criterion")
    for c in checks:
        if not isinstance(c, dict) or c.get("passed") is not True or not _text(c.get("path")):
            raise ValueError("each criterion requires a checked artifact")
        p = c["path"]
        if not os.path.isabs(p) or os.path.islink(p) or not os.path.isfile(p):
            raise ValueError("artifact must be an absolute regular-file path")
        with open(p, 'rb') as f:
            hashed = hashlib.sha256()
            for chunk in iter(lambda: f.read(1024 * 1024), b''):
                hashed.update(chunk)
            digest = hashed.hexdigest()
        if c.get("sha256") != digest:
            raise ValueError("artifact hash mismatch: " + p)


def cmd_verify(args):
    path, data, n = _task(args)
    plan = n.get("workflow") or {}
    proof, binding = _json_evidence(args.evidence)
    if (not plan or n.get("superseded_by") or proof.get("task_id") != n['id'] or proof.get("owner_session") != plan.get("owner_session")
            or proof.get("plan_sha256") != plan.get("binding", {}).get("sha256")
            or not _text(proof.get("verifier_session")) or proof["verifier_session"] == plan["owner_session"]
            or not _fresh(proof.get("checked_at")) or proof.get("result") not in ("passed", "partial", "blocked")):
        raise ValueError("fresh independent verification must bind this task and owner")
    terminal = proof.get("terminal") or {}
    if terminal.get("status") not in ("completed", "failed", "interrupted"):
        raise ValueError("owner terminal status is required; idle alone is not completion")
    dispatch = n.get("dispatch")
    if proof.get("attempt") is not None and not dispatch:
        raise ValueError("prior dispatch cannot verify the current plan")
    if dispatch and (dispatch.get("state") != "delivered" or not dispatch.get("turn_id")
                     or dispatch.get("owner_session") != plan["owner_session"]
                     or dispatch.get("plan") != plan["binding"]
                     or proof.get("attempt") != dispatch.get("id")
                     or not _text(terminal.get("id"))
                     or type(terminal.get("started_at")) is not int
                     or terminal['started_at'] < dispatch['prepared_at'] - 5
                     or (dispatch.get("turn_id") and terminal['id'] != dispatch['turn_id'])):
        raise ValueError("verification must bind this dispatch and its actual owner turn")
    if proof["result"] == "passed":
        if terminal.get("status") != "completed" or "error" not in terminal or terminal["error"] is not None:
            raise ValueError("successful original terminal result required")
        _checked_artifacts(proof, plan["acceptance"])
        _check_close(data, n['id'])
        n["status"] = "done"
        n.pop("_pre_rollup_status", None)
    else:
        if not _text(proof.get("reason")):
            raise ValueError("partial/blocked verification needs a concrete reason")
        n["status"] = "blocked"
    n["verification"] = dict(result=proof['result'], checked_at=proof['checked_at'], evidence=binding,
                             reason=proof.get('reason', ''))
    if n.get("dispatch"):
        n["dispatch"]["state"] = "reconciled"
    _record(path, data, n, "verification-" + proof['result'], binding)
    print(n['id'])
    return 0


def cmd_supersede(args):
    path, data, n = _task(args)
    proof, binding = _json_evidence(args.evidence)
    target = _find(data, proof.get("target_id"))
    if (proof.get("task_id") != n['id'] or not _fresh(proof.get("checked_at"))
            or not _text(proof.get("reason")) or not target or target['id'] == n['id']
            or target.get("superseded_by") or _pending(n) or n['status'] in LEAF_DONE):
        raise ValueError("supersession needs a current canonical target and source proof")
    _checked_artifacts(proof, ["same outcome or superseded authority"])
    _check_close(data, n['id'])
    n["superseded_by"] = target['id']
    n["status"] = "dropped"
    n["auto"] = False  # retain the original source key/history across collector pruning
    _record(path, data, n, "superseded", {"target_id": target['id'], **binding})
    print(n['id'])
    return 0


def self_test():
    """Fixture-backed end-to-end pass over the real code paths, in /tmp."""
    import shutil
    tmp = tempfile.mkdtemp(prefix="loose-tree-selftest-")
    failures = []

    def check(label, cond):
        if not cond:
            failures.append(label)

    def run(*argv, fault=False, store=None):
        env = dict(os.environ)
        env.pop("LOOSE_TREE_FAULT", None)
        if fault:
            env["LOOSE_TREE_FAULT"] = "1"
        argv = list(argv)
        if store:
            argv = ["--store", store] + argv
        import subprocess
        p = subprocess.run([sys.executable, os.path.abspath(__file__)] + argv,
                           capture_output=True, text=True, env=env, timeout=30)
        return p

    store = os.path.join(tmp, "loosetree.json")
    p = run("add", "--title", "Website", "--kind", "project",
            "--origin", "chat:Website design", "--harness", "hermes/ops",
            "--session", "s1", store=store)
    check("add project rc", p.returncode == 0)
    pid = p.stdout.strip()
    check("add project id shape", pid.startswith("T-"))
    p = run("add", "--parent", pid, "--title", "Form provider",
            "--status", "needs-decision", store=store)
    check("add child rc", p.returncode == 0)
    c1 = p.stdout.strip()
    d = json.load(open(store, encoding="utf-8"))
    check("child linked", d["nodes"][1]["parent"] == pid)
    check("child status", d["nodes"][1]["status"] == "needs-decision")
    check("rollup counted", d["nodes"][0]["rollup"]["total"] == 1)
    # done parent with open child refused
    p = run("done", pid, store=store)
    check("parent done refused", p.returncode == 1)
    # record a decision -> actionable again
    p = run("update", c1, "--decision", "use provider X", store=store)
    check("decision recorded", p.returncode == 0)
    d = json.load(open(store, encoding="utf-8"))
    check("decision clears needs-decision",
          d["nodes"][1]["status"] == "todo")
    # close child -> parent auto-done
    p = run("done", c1, store=store)
    check("child done", p.returncode == 0)
    d = json.load(open(store, encoding="utf-8"))
    check("parent auto-done", d["nodes"][0]["status"] == "done")
    # reopen child -> parent restores pre-rollup status
    p = run("update", c1, "--status", "doing", store=store)
    d = json.load(open(store, encoding="utf-8"))
    check("reopen restores parent",
          d["nodes"][0]["status"] == "todo")
    # update: provenance fields (commit/note) and re-parenting
    p = run("add", "--title", "prov", store=store)
    prov_id = p.stdout.strip()
    p = run("update", prov_id, "--status", "doing", "--commit",
            "abc1234 (pushed)", "--note", "mid-flight", store=store)
    check("update rc", p.returncode == 0)
    d = json.load(open(store, encoding="utf-8"))
    pn = next(n for n in d["nodes"] if n["id"] == prov_id)
    check("update commit", "abc1234" in pn["commit"])
    check("update note", pn["note"] == "mid-flight")
    check("update status", pn["status"] == "doing")
    p = run("update", prov_id, "--parent", pid, store=store)
    check("re-parent rc", p.returncode == 0)
    d = json.load(open(store, encoding="utf-8"))
    check("re-parented", next(n for n in d["nodes"]
                              if n["id"] == prov_id)["parent"] == pid)
    # board collapses the Inbox subtree by default; --inbox expands.
    shell = run("add", "--title", "inbox-shell", "--kind", "inbox", "--auto",
                "--auto-key", "k-shell", store=store)
    shell_id = shell.stdout.strip()
    ib = run("add", "--title", "inbox-child-visible", store=store)
    ib_id = ib.stdout.strip()
    # re-parent the child under the inbox shell
    run("update", ib_id, "--parent", shell_id, store=store)
    p = run("board", store=store)
    check("board inbox collapsed", "inbox-child-visible" not in p.stdout
          and "INBOX" in p.stdout)
    p = run("board", "--inbox", store=store)
    check("board --inbox expands", "inbox-child-visible" in p.stdout)
    run("done", ib_id, store=store)

    # board ordering: awaiting-trevor first, done hidden without --all
    run("add", "--title", "q-await", "--status", "awaiting-trevor",
        store=store)
    run("add", "--title", "q-done", "--status", "done", store=store)
    p = run("board", store=store)
    check("board awaiting first",
          p.stdout.index("q-await") < p.stdout.index("Website"))
    check("board hides done", "q-done" not in p.stdout)
    p = run("board", "--all", store=store)
    check("board --all shows done", "q-done" in p.stdout)
    # adopt an auto inbox item under the project
    p = run("add", "--title", "auto find", "--auto",
            "--auto-key", "k1", store=store)
    aid = p.stdout.strip()
    p = run("adopt", aid, "--parent", pid, store=store)
    check("adopt rc", p.returncode == 0)
    d = json.load(open(store, encoding="utf-8"))
    adopted = next(n for n in d["nodes"] if n["id"] == aid)
    check("adopted flags", adopted["auto"] is False and
          adopted["parent"] == pid and adopted["kind"] == "task")
    # atomic write: injected fault leaves store intact, no tmp left
    p = run("add", "--title", "boom", fault=True, store=store)
    check("fault fails", p.returncode != 0)
    d2 = json.load(open(store, encoding="utf-8"))
    check("store survives fault",
          all(n["title"] != "boom" for n in d2["nodes"]))
    check("no tmp left",
          not [f for f in os.listdir(os.path.dirname(store))
               if f.endswith(".tmp")])
    # bad inputs fail closed
    check("bad status fails", run("add", "--title", "x", "--status", "weird",
                                  store=store).returncode == 1)
    check("missing parent fails",
          run("add", "--title", "x", "--parent", "T-nope",
              store=store).returncode == 1)
    check("missing item fails",
          run("update", "T-nope", "--status", "doing",
              store=store).returncode == 1)

    shutil.rmtree(tmp, ignore_errors=True)
    if failures:
        print("loose-tree self-test FAILED: " + ", ".join(failures),
              file=sys.stderr)
        return 1
    print("loose-tree self-test: ok")
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if "--self-test" in argv:
        return self_test()
    p = argparse.ArgumentParser(prog="loose-tree")
    p.add_argument("--store", help="store path (default MISSION_CONTROL_HOME "
                                   "loosetree/store.json)")
    sub = p.add_subparsers(dest="cmd")

    a = sub.add_parser("add")
    a.add_argument("--parent"), a.add_argument("--kind")
    a.add_argument("--title"), a.add_argument("--status")
    a.add_argument("--origin"), a.add_argument("--harness")
    a.add_argument("--session"), a.add_argument("--repo")
    a.add_argument("--commit"), a.add_argument("--note")
    a.add_argument("--auto", action="store_true")
    a.add_argument("--auto-key")
    a.set_defaults(func=cmd_add)

    u = sub.add_parser("update")
    u.add_argument("id")
    u.add_argument("--status"), u.add_argument("--title")
    u.add_argument("--commit"), u.add_argument("--note")
    u.add_argument("--decision"), u.add_argument("--parent")
    u.set_defaults(func=cmd_update)

    d = sub.add_parser("done"); d.add_argument("id")
    d.set_defaults(func=cmd_done)
    dr = sub.add_parser("drop"); dr.add_argument("id")
    dr.set_defaults(func=cmd_drop)
    ad = sub.add_parser("adopt"); ad.add_argument("id")
    ad.add_argument("--parent"); ad.set_defaults(func=cmd_adopt)

    b = sub.add_parser("board")
    b.add_argument("--all", action="store_true")
    b.add_argument("--inbox", action="store_true",
                   help="expand auto-captured Inbox items (hidden by default)")
    b.set_defaults(func=cmd_board)
    s = sub.add_parser("show"); s.add_argument("id")
    s.set_defaults(func=cmd_show)
    j = sub.add_parser("json"); j.set_defaults(func=cmd_json)

    m = sub.add_parser("manage")
    m.add_argument("id"); m.add_argument("--plan", required=True)
    m.set_defaults(func=cmd_manage)
    q = sub.add_parser("queue"); q.set_defaults(func=cmd_queue)
    dp = sub.add_parser("dispatch")
    dp.add_argument("id"); dp.add_argument("--observation", required=True)
    dp.set_defaults(func=cmd_dispatch)
    for name, func in (("receipt", cmd_receipt), ("verify", cmd_verify), ("supersede", cmd_supersede)):
        ep = sub.add_parser(name)
        ep.add_argument("id"); ep.add_argument("--evidence", required=True)
        ep.set_defaults(func=func)

    args = p.parse_args(argv)
    if not getattr(args, "func", None):
        p.print_usage(sys.stderr)
        return 64
    try:
        with store_lock(_store_path(args)):
            return args.func(args)
    except (OSError, ValueError) as exc:
        print("loose-tree: " + str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
